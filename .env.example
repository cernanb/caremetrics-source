# Copy to .env and adjust as needed:  cp .env.example .env
# .env is gitignored; this file is the committed template.

# --- Local PostgreSQL container (read by docker compose) ---
POSTGRES_USER=caremetrics
POSTGRES_PASSWORD=caremetrics_local_dev
POSTGRES_DB=caremetrics
# Host port mapped to the container's 5432.
# 5433 avoids clashing with a locally installed Postgres (e.g. Postgres.app) on 5432.
POSTGRES_PORT=5433

# --- Connection used by the Python migration and seed scripts ---
# For local dev this points at the container above.
# Later, replace it with a Neon connection string (sslmode=require).
DATABASE_URL=postgresql://caremetrics:caremetrics_local_dev@localhost:5433/caremetrics

# --- Synthetic data generation ---
# Same seed + same anchor date => identical dataset on every reseed.
SEED_RANDOM_SEED=42
# "Today" from the generator's point of view. History goes back ~2 years
# from this date, and future scheduled appointments go ~60 days forward.
SEED_ANCHOR_DATE=2026-10-01